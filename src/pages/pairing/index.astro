---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Downloads from "../../components/Downloads.astro";
---

<BaseLayout
  title="iloader Pairing File Guide - Official Instructions"
  description="Official iloader pairing file guide for StikDebug and Protokolle."
  canonical="https://iloader.app/pairing"
  robots="noindex, follow"
>
  <div class="workspace">
    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">Pairing</p>
        <span class="section-hint">Place pairing file</span>
      </div>
      <div class="glass-card">
        <h2>Pairing File</h2>
        <p>
          iloader can create a pairing file for apps like StikDebug or
          Protokolle to talk to your device remotely. This pairing file is
          device-specific, time-specific, and required to use those apps.
        </p>
        <div>
          <h3>Place Pairing File</h3>
          <ol>
            <li>
              Install iloader and its requirements from the downloads below.
            </li>
            <li>
              Connect your iDevice to your computer via USB cable. If your
              device appears wirelessly, that will work too. Then click refresh.
              Your device should appear in the list.
            </li>
            <li>
              Click "<span style="font-family: monospace"
                >Manage Pairing File</span
              >"
            </li>
            <li>
              To the right of your chosen app, click Place. "Pairing file placed
              successfully!" should appear in green.
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">Download</p>
        <span class="section-hint">Choose a build</span>
      </div>
      <Downloads />
    </section>

    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">About</p>
        <span class="section-hint">Info about iloader</span>
      </div>
      <div class="glass-card">
        <h2>About iloader</h2>
        <p>
          iloader is a free and open-source user-friendly sideloader designed to
          make installing SideStore or other apps on an iDevice as easy as
          possible. Learn more on the iloader home page.
        </p>
        <a class="button" href="/">iloader Home Page</a>
      </div>
    </section>
  </div>
</BaseLayout>
