---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Downloads from "../components/Downloads.astro";
import TechnicalDetails from "../components/TechnicalDetails.astro";
import FAQ from "../components/FAQ.astro";
import Beta from "../components/Beta.astro";
import Translators from "../components/Translators.astro";
---

<BaseLayout
  title="iloader - Free Open-Source iOS Sideloading Companion"
  description="Official website for iloader, the free and open-source iOS sideloading tool. Download for Windows, Mac, and Linux to install SideStore or other apps."
  canonical="https://iloader.app/"
>
  <div class="workspace">
    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">About</p>
        <span class="section-hint">Info about iloader</span>
      </div>
      <About />
    </section>

    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">Download</p>
        <span class="section-hint">Choose a build</span>
      </div>
      <Downloads />
    </section>

    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">iloader-next</p>
        <span class="section-hint">The next Beta version of iloader</span>
      </div>
      <Beta />
    </section>

    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">FAQ</p>
        <span class="section-hint">Frequently asked questions</span>
      </div>
      <FAQ />
    </section>

    <section class="workspace-section">
      <div class="section-header">
        <p class="section-label">Credits</p>
        <span class="section-hint">Contributors and more</span>
      </div>
      <div class="glass-card">
        <h2>Contributors</h2>
        <p>
          While developed primarily by me, nab138, iloader is only possible
          because of the large community of open-source developers,
          contributors, users, and more involved with sideloading. Thank you
          all!
        </p>
        <div class="contributors favor-first-two">
          <div class="card">
            <a href="https://nabdev.me" target="_blank" rel="noreferrer"
              >nab138</a
            ><span class="subtitle">Creator & Maintainer</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/StephenDev0"
              target="_blank"
              rel="noreferrer">StephenDev0</a
            ><span class="subtitle">UI Overhaul</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/se2crid"
              target="_blank"
              rel="noreferrer">se2crid</a
            ><span class="subtitle">Contributor</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/CelloSerenity"
              target="_blank"
              rel="noreferrer">CelloSerenity</a
            ><span class="subtitle">Contributor</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/jkcoxson"
              target="_blank"
              rel="noreferrer">jkcoxson</a
            ><span class="subtitle">Contributor</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/hugeBlack"
              target="_blank"
              rel="noreferrer">hugeBlack</a
            ><span class="subtitle">Contributor</span>
          </div>
        </div>

        <h2>Special Thanks</h2>
        <div class="contributors favor-first-three">
          <div class="card">
            <a
              href="https://github.com/transistor-exe"
              target="_blank"
              rel="noreferrer">Transistor</a
            ><span class="subtitle">Icon Designer</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/jkcoxson/idevice"
              target="_blank"
              rel="noreferrer">idevice by jkcoxson</a
            ><span class="subtitle">Device Communication Library</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/nab138/isideload"
              target="_blank"
              rel="noreferrer">isideload by nab138</a
            ><span class="subtitle">Sideloading Library</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/Dadoum/apple-crates"
              target="_blank"
              rel="noreferrer">apple-codesign-quick by Dadoum</a
            ><span class="subtitle">Codesigning Library</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/khcrysalis/Impactor"
              target="_blank"
              rel="noreferrer">Impactor by khcrysalis</a
            ><span class="subtitle">Reference Code</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/Dadoum/Sideloader"
              target="_blank"
              rel="noreferrer">Sideloader by Dadoum</a
            ><span class="subtitle">Reference Code</span>
          </div>
          <div class="card">
            <a
              href="https://github.com/jkcoxson/idevice_pair"
              target="_blank"
              rel="noreferrer">idevice_pair by jkcoxson</a
            ><span class="subtitle">Reference Code</span>
          </div>
          <div class="card">
            <a href="https://tauri.app" target="_blank" rel="noreferrer"
              >Tauri</a
            ><span class="subtitle">App Framework</span>
          </div>
        </div>

        <h2>Translators</h2>
        <Translators />
      </div>

      <section class="workspace-section">
        <div class="section-header">
          <p class="section-label">Technical Details</p>
          <span class="section-hint">How iloader works</span>
        </div>

        <TechnicalDetails />
      </section>
    </section>
  </div>
</BaseLayout>
