---
import { translators } from "../data/translators";
---

<div class="contributors">
  {
    translators.map(({ username, language, lang_codes }) => (
      <div class="card">
        <span>
          <>
            <a href={`https://github.com/${username}`} target="_blank" rel="noreferrer">{username}</a>
            <span class="subtitle" style="margin-left: 0.4rem">
              ({lang_codes.join(", ")})
            </span>
          </>
        </span>

        <span class="subtitle">{language}</span>
      </div>
    ))
  }
</div>

<p class="subtitle">
  You can contribute translations <a
    href="https://github.com/nab138/iloader?tab=readme-ov-file#translating"
    target="_blank"
    rel="noreferrer">here.</a
  >
</p>
